package torse:behavior@0.3.0-draft;

interface types {
    record vec3i {
        x: s64,
        y: s64,
        z: s64,
    }

    record bbox {
        min: vec3i,
        max: vec3i,
    }

    record entity-id {
        low: u64,
        high: u64,
    }

    // Trees use postorder indices. Every non-root node has one parent;
    // children precede their parent, and the root is the last node.
    record node-field {
        key: string,
        value: u32,
    }
    variant value-node {
        %bool(bool),
        %u32(u32),
        %i64(s64),
        content(u32),
        entity(entity-id),
        text(string),
        %list(list<u32>),
        %record(list<node-field>),
    }
    record value-tree {
        nodes: list<value-node>,
    }

    variant atom {
        %bool(bool),
        %u32(u32),
        %i64(s64),
        content(u32),
        entity(entity-id),
        text(string),
        tree(value-tree),
    }

    record field {
        key: string,
        value: atom,
    }

    record block-ref {
        definition: u32,
        state-values: list<u16>,
    }

    variant cell {
        not-loaded,
        empty,
        occupied(block-ref),
    }

    enum query-error {
        out-of-range,
        budget-exceeded,
        not-authorized,
        invalid-cursor,
        // The requested representation contains an unknown symbol or shape.
        unsupported,
    }
}

interface query {
    use types.{vec3i, bbox, entity-id, field, cell, query-error};

    resolve-symbol: func(key: string) -> option<u32>;
    symbol-key: func(symbol: u32) -> option<string>;

    record cell-sample {
        pos: vec3i,
        cell: cell,
    }

    query-blocks: func(region: bbox) -> result<list<cell-sample>, query-error>;

    record entity-sample {
        id: entity-id,
        position: vec3i,
    }

    record entity-page {
        items: list<entity-sample>,
        next: option<string>,
    }

    query-entities: func(region: bbox, cursor: option<string>, limit: u32)
        -> result<entity-page, query-error>;

    record component-target {
        entity: entity-id,
        schema: u32,
    }

    record component-snapshot {
        entity: entity-id,
        fields: option<list<field>>,
    }

    read-components: func(targets: list<component-target>)
        -> result<list<component-snapshot>, query-error>;

    record port-estimate {
        accepts: list<u32>,
        free-estimate: u32,
    }

    probe-item-port: func(entity: entity-id, port: string) -> option<port-estimate>;
}

interface diagnostics {
    enum log-level {
        trace,
        info,
        warn,
        error,
    }

    log: func(level: log-level, message: string);
}

interface schedule {
    use types.{entity-id};

    record wakeup-slot {
        entity: entity-id,
        tick: u64,
        key: string,
    }

    pending-wakeups: func(key-prefix: option<string>) -> list<wakeup-slot>;
}

interface invoke {
    use types.{vec3i, cell, entity-id, field};

    record owned-state {
        schema: u32,
        fields: option<list<field>>,
    }

    record object-ref {
        entity: entity-id,
        pos: vec3i,
        block: u32,
        owned: list<owned-state>,
    }

    record wakeup-target {
        entity: entity-id,
        key: string,
    }

    variant action-target {
        block(vec3i),
        entity(entity-id),
    }
    record interaction {
        caller: string,
        action: string,
        api-version: u32,
        target: action-target,
        parameters: list<field>,
    }

    record entity-spawn {
        pos: vec3i,
        components: list<owned-state>,
    }

    variant event {
        init,
        wakeup(wakeup-target),
        block-placed,
        block-broken(cell),
        interaction(interaction),
    }

    record invocation {
        event: event,
        tick: u64,
        self: option<object-ref>,
        rng-seed: u64,
    }

    // Slots identify inventory positions directly in P2; the port abstraction
    // stays an open design item until the inventory module exposes it.
    record transfer-request {
        source: entity-id,
        source-slot: u32,
        destination: entity-id,
        destination-slot: u32,
        count: u32,
    }

    record block-edit {
        pos: vec3i,
        expected: option<cell>,
        new: cell,
    }

    record component-edit {
        entity: entity-id,
        schema: u32,
        previous: option<list<field>>,
        fields: option<list<field>>,
    }

    record wakeup-request {
        entity: entity-id,
        tick: u64,
        key: string,
    }

    record plan {
        edits: list<block-edit>,
        component-edits: list<component-edit>,
        transfers: list<transfer-request>,
        wakeups: list<wakeup-request>,
        spawns: list<entity-spawn>,
        despawns: list<entity-id>,
    }

    handle-event: func(invocation: invocation) -> option<plan>;
}

world mod-behavior {
    import query;
    import diagnostics;
    import schedule;

    export invoke;
}
